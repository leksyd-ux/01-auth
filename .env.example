# ==============================================================================
# ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env and configure the values for your environment.
# ==============================================================================

# Database Connection: PostgreSQL connection string
# Local example: postgresql://localhost:5432/assessment_auth?schema=public
# Or with user: postgresql://<username>:<password>@localhost:5432/<dbname>?schema=public
DATABASE_URL="postgresql://user:password@localhost:5432/assessment_auth?schema=public"

# Application Base URL: Used to formulate absolute email verification / password reset links
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Application Secret: Cryptographic seed used for token HMAC generation (min 32 characters)
AUTH_SECRET="change-me-to-a-secure-random-32-byte-hex-string"

# Node Environment: 'development' | 'production' | 'test'
NODE_ENV="development"
